{
  "name": "decky-wine-cellar",
  "type": "module",
  "version": "0.2.1",
  "description": "A decky plugin to manage Steam Play compatibility tools",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "tsc --noEmit",
    "check": "pnpm test && pnpm build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlashyReese/decky-wine-cellar.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "plugin-template",
    "steam-deck",
    "deck"
  ],
  "author": "Yao Chung Hu <flashyreese@protonmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FlashyReese/decky-wine-cellar/issues"
  },
  "homepage": "https://github.com/FlashyReese/decky-wine-cellar#readme",
  "devDependencies": {
    "@decky/ui": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5",
    "vite-plugin-external": "^8.0.3",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@fluent/bundle": "^0.19.1",
    "@fluent/react": "^0.15.2",
    "react-icons": "^5.7.0",
    "react-markdown": "^9.1.0",
    "react-qr-code": "^2.2.0",
    "remark-gfm": "^4.0.1",
    "tslib": "^2.8.1",
    "uuid": "^11.1.1"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "current"
      ],
      "libc": [
        "glibc",
        "musl"
      ]
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
