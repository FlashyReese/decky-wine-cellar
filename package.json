{
  "name": "decky-wine-cellar",
  "type": "module",
  "version": "0.2.1",
  "description": "A decky plugin to manage Steam Play compatibility tools",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "tsc --noEmit",
    "check": "pnpm test && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlashyReese/decky-wine-cellar.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "plugin-template",
    "steam-deck",
    "deck"
  ],
  "author": "Yao Chung Hu <flashyreese@protonmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FlashyReese/decky-wine-cellar/issues"
  },
  "homepage": "https://github.com/FlashyReese/decky-wine-cellar#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "rollup": "4.63.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@fluent/bundle": "^0.19.1",
    "@fluent/react": "^0.15.2",
    "react-icons": "^5.7.0",
    "react-markdown": "^9.1.0",
    "react-qr-code": "^2.2.0",
    "remark-gfm": "^4.0.1",
    "tslib": "^2.8.1",
    "uuid": "^11.1.1"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "current"
      ],
      "libc": [
        "glibc",
        "musl"
      ]
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
